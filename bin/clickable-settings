#!/usr/bin/env python3

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))

from clickable_settings import read_settings, SettingsError, write_settings


def main(arguments):
  try:
    if len(arguments) == 2 and arguments[0] == "read":
      text = read_settings(arguments[1])
      sys.stdout.write(json.dumps({"text": text}, separators=(",", ":")) + "\n")
      return 0
    if len(arguments) == 3 and arguments[0] == "write":
      write_settings(arguments[1], arguments[2])
      return 0
  except SettingsError as error:
    sys.stderr.write(error.message + "\n")
    return 1

  sys.stderr.write("Usage: clickable-settings read CONFIG_HOME | write CONFIG_HOME JSON\n")
  return 2


raise SystemExit(main(sys.argv[1:]))
